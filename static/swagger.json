{
    "openapi": "3.0.0",
    "info": {
      "title": "IMDb Clone API",
      "description": "API for accessing movie and actor information",
      "version": "1.0.0"
    },
    "servers": [
      {
        "url": "http://localhost:5000/api",
        "description": "Local development server"
      }
    ],
    "paths": {
      "/movies": {
        "get": {
          "summary": "Get all movies",
          "description": "Returns a list of movies with optional pagination and search",
          "parameters": [
            {
              "name": "page",
              "in": "query",
              "description": "Page number",
              "required": false,
              "schema": {
                "type": "integer",
                "default": 1
              }
            },
            {
              "name": "per_page",
              "in": "query",
              "description": "Items per page",
              "required": false,
              "schema": {
                "type": "integer",
                "default": 10
              }
            },
            {
              "name": "search",
              "in": "query",
              "description": "Search query",
              "required": false,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "A list of movies",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "movies": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Movie"
                        }
                      },
                      "page": {
                        "type": "integer"
                      },
                      "per_page": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "post": {
          "summary": "Add a new movie",
          "description": "Creates a new movie record",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieInput"
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Movie created successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      },
                      "movie_id": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Invalid input"
            }
          }
        }
      },
      "/movies/{movie_id}": {
        "get": {
          "summary": "Get movie by ID",
          "description": "Returns detailed information about a specific movie",
          "parameters": [
            {
              "name": "movie_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Movie details",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/MovieDetail"
                  }
                }
              }
            },
            "404": {
              "description": "Movie not found"
            }
          }
        },
        "put": {
          "summary": "Update movie",
          "description": "Updates an existing movie",
          "parameters": [
            {
              "name": "movie_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieInput"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Movie updated successfully"
            },
            "400": {
              "description": "Invalid input"
            },
            "404": {
              "description": "Movie not found"
            }
          }
        },
        "delete": {
          "summary": "Delete movie",
          "description": "Deletes a movie record",
          "parameters": [
            {
              "name": "movie_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Movie deleted successfully"
            },
            "404": {
              "description": "Movie not found"
            }
          }
        }
      },
      "/movies/top-rated": {
        "get": {
          "summary": "Get top rated movies",
          "description": "Returns a list of top rated movies",
          "parameters": [
            {
              "name": "limit",
              "in": "query",
              "description": "Number of movies to return",
              "required": false,
              "schema": {
                "type": "integer",
                "default": 10
              }
            }
          ],
          "responses": {
            "200": {
              "description": "A list of top rated movies",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "movies": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Movie"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/movies/{movie_id}/actors": {
        "post": {
          "summary": "Add actor to movie",
          "description": "Adds an actor to a movie with a specific role",
          "parameters": [
            {
              "name": "movie_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "actor_id": {
                      "type": "integer"
                    },
                    "role": {
                      "type": "string"
                    }
                  },
                  "required": ["actor_id", "role"]
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Actor added to movie successfully"
            },
            "400": {
              "description": "Invalid input"
            }
          }
        }
      },
      "/movies/{movie_id}/actors/{actor_id}": {
        "delete": {
          "summary": "Remove actor from movie",
          "description": "Removes an actor from a movie",
          "parameters": [
            {
              "name": "movie_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              }
            },
            {
              "name": "actor_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Actor removed from movie successfully"
            },
            "404": {
              "description": "Actor not found in movie"
            }
          }
        }
      },
      "/movies/{movie_id}/reviews": {
        "get": {
          "summary": "Get movie reviews",
          "description": "Returns all reviews for a specific movie",
          "parameters": [
            {
              "name": "movie_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "A list of reviews",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "reviews": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Review"
                        }
                      }
                    }
                  }
                }
              }
            },
            "404": {
              "description": "Movie not found"
            }
          }
        },
        "post": {
          "summary": "Add review to movie",
          "description": "Adds a review to a movie",
          "parameters": [
            {
              "name": "movie_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "integer"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "integer"
                    },
                    "rating": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "comment": {
                      "type": "string"
                    }
                  },
                  "required": ["user_id", "rating"]
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Review added successfully"
            },
            "400": {
              "description": "Invalid input"
            }
          }
        }
      },
      "/actors": {
        "get": {
          "summary": "Get all actors",
