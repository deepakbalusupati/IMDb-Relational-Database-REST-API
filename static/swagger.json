            }
          ],
          "responses": {
            "200": {
              "description": "Actor details",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ActorDetail"
                  }
                }
              }
            },
            "404": {
              "description": "Actor not found"
            }
          }
        },
        "put": {
          "summary": "Update actor",
          "description": "Updates an existing actor",
          "parameters": [
            {
              "name": "actor_id",
              "in": "path",
              "required": true,
