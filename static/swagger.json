            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActorInput"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Actor updated successfully"
            },
            "400": {
