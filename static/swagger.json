      "/login": {
        "post": {
          "summary": "User login",
          "description": "Authenticates a user and returns user details",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string"
                    }
                  },
                  "required": ["username", "password"]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Login successful",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      },
                      "user": {
                        "$ref": "#/components/schemas/User"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "description": "Invalid credentials"
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "Movie": {
          "type": "object",
          "properties": {
            "movie_id": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "release_year": {
              "type": "integer"
            },
            "rating": {
              "type": "number",
              "format": "float"
            },
            "plot": {
              "type": "string"
            },
            "duration_minutes": {
              "type": "integer"
            },
            "genres": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "MovieDetail": {
          "type": "object",
          "properties": {
            "movie_id": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "release_year": {
              "type": "integer"
            },
            "rating": {
              "type": "number",
              "format": "float"
            },
            "plot": {
              "type": "string"
            },
            "duration_minutes": {
              "type": "integer"
            },
            "genres": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "actors": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/MovieActor"
              }
            },
            "reviews": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Review"
              }
            }
          }
        },
        "MovieInput": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "release_year": {
              "type": "integer"
            },
            "rating": {
              "type": "number",
              "format": "float"
            },
            "plot": {
              "type": "string"
            },
            "duration_minutes": {
              "type": "integer"
            },
            "genres": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          "required": ["title", "release_year", "rating", "plot", "duration_minutes"]
        },
        "MovieActor": {
          "type": "object",
          "properties": {
            "actor_id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "birth_date": {
              "type": "string",
              "format": "date"
            },
            "role": {
              "type": "string"
            }
          }
        },
        "Review": {
          "type": "object",
          "properties": {
            "review_id": {
              "type": "integer"
            },
            "rating": {
              "type": "integer"
            },
            "comment": {
              "type": "string"
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "username": {
              "type": "string"
            }
          }
        },
        "Actor": {
          "type": "object",
          "properties": {
            "actor_id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "birth_date": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "ActorDetail": {
          "type": "object",
          "properties": {
            "actor_id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "birth_date": {
              "type": "string",
              "format": "date"
            },
            "bio": {
              "type": "string"
            },
            "movies": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ActorMovie"
              }
            }
          }
        },
        "ActorInput": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "birth_date": {
              "type": "string",
              "format": "date"
            },
            "bio": {
              "type": "string"
            }
          },
          "required": ["name"]
        },
        "ActorMovie": {
          "type": "object",
          "properties": {
            "movie_id": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "release_year": {
              "type": "integer"
            },
            "role": {
              "type": "string"
            }
          }
        },
        "User": {
          "type": "object",
          "properties": {
            "user_id": {
              "type": "integer"
            },
            "username": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "UserInput": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          },
          "required": ["username", "email", "password"]
        }
      }
    }
  }