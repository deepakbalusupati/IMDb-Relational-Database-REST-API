                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "User updated successfully"
            },
            "400": {
              "description": "Invalid input"
            },
            "404": {
              "description": "User not found"
            }
          }
        },
        "delete": {
          "summary": "Delete user",
          "description": "Deletes a user record",
          "parameters": [
            {
              "name": "user_id",
              "in": "path",
